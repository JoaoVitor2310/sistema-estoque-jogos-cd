# Modelo de ambiente. **Nenhum valor real deste projeto entra aqui** — este
# arquivo é versionado, e valor versionado é valor publicado. Onde há segredo ou
# identidade (banco, e-mail, chaves de API), o campo fica em branco de
# propósito: preencha no seu `.env`, que não vai para o git.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:170

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# O host é o nome do serviço no docker-compose, e a porta é a interna do
# container — a publicada no host está fechada no loopback de propósito.
DB_CONNECTION=pgsql
DB_HOST=postgres-cd
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Mesmos valores de DB_DATABASE/USERNAME/PASSWORD: é o que o container do
# Postgres usa para criar o banco na primeira subida.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção, com HTTPS: true. Sem isso o cookie de sessão não é marcado
# `Secure` e viaja em qualquer downgrade para HTTP.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis-cd
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

API_KEY_AWESOME_API=
API_KEY_GG_DEALS=

API_PRICE_RESEARCHER=

# Produção real: qualquer chamada afeta estoque e vendas na hora.
API_GAMIVO_URL=
API_KEY_GAMIVO=
GAMIVO_SELLER_NAME=

# Destinatário dos alertas e identidade do admin (Gate 'is-admin').
# Não tem fallback no código: em branco = nenhum admin e nenhum alerta entregue.
ADMIN_EMAIL=
EXTERNAL_SECRET=
